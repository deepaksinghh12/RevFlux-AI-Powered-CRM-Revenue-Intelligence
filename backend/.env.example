# Server Configuration
PORT=8080
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/revflux

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=30d

# OpenRouter / Gemini AI Integration
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Resend Email Integration & Centralized Senders (Verified Domain: revflux.deepaksinghdev.in)
RESEND_API_KEY=your_resend_api_key_here
RESEND_SECURITY_FROM_EMAIL=RevFlux Security <security@revflux.deepaksinghdev.in>
RESEND_ONBOARDING_FROM_EMAIL=RevFlux Team <onboarding@revflux.deepaksinghdev.in>
RESEND_NOTIFICATIONS_FROM_EMAIL=RevFlux Notifications <notifications@revflux.deepaksinghdev.in>
RESEND_BILLING_FROM_EMAIL=RevFlux Billing <billing@revflux.deepaksinghdev.in>
RESEND_SUPPORT_FROM_EMAIL=RevFlux Support <support@revflux.deepaksinghdev.in>
RESEND_UPDATES_FROM_EMAIL=RevFlux Updates <updates@revflux.deepaksinghdev.in>
RESEND_GENERAL_FROM_EMAIL=RevFlux Team <hello@revflux.deepaksinghdev.in>
RESEND_REPORTS_FROM_EMAIL=RevFlux Reports <reports@revflux.deepaksinghdev.in>

# Cloudinary Attachments
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Monetization (Optional)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
